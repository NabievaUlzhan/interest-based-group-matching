        authz["Access control<br/>token check, role check,<br/>ownership check (organizer_id)"]
        dal["Data-access layer<br/>SQLAlchemy"]
    end

    db[("PostgreSQL")]
    migr["Alembic<br/>migrations"]

    client -- "HTTPS REST (JSON), Bearer token" --> auth
