flowchart TB
    client["React + TypeScript web client (Vite)<br/>Sign up / Log in, Profile, Interest Selection,<br/>Group Discovery, Events Listing, Event Detail / RSVP"]

    subgraph backend ["FastAPI backend (REST API, Pydantic validation)"]
        auth["Auth service<br/>JWT, Argon2 password hashing"]
        profile["Profile / Interests service"]
