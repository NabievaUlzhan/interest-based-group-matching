erDiagram
    USERS ||--o{ USER_INTERESTS : "selects"
    INTERESTS ||--o{ USER_INTERESTS : "chosen by"
    GROUPS ||--o{ GROUP_INTERESTS : "tagged with"
    INTERESTS ||--o{ GROUP_INTERESTS : "describes"
    USERS ||--o{ GROUPS : "owns"
    USERS ||--o{ GROUP_MEMBERS : "joins"
    GROUPS ||--o{ GROUP_MEMBERS : "has members"
    GROUPS |o--o{ EVENTS : "may host"
    USERS ||--o{ EVENTS : "organizes"
    USERS ||--o{ RSVPS : "registers"
    EVENTS ||--o{ RSVPS : "has"

    USERS {
        int id PK
        string email UK
        string password_hash
        string display_name
    }
    INTERESTS {
        int id PK
        string name UK
    }
    USER_INTERESTS {
        int user_id PK, FK
        int interest_id PK, FK
    }
    GROUPS {
        int id PK
        string title
        string description
        int owner_id FK
    }
    GROUP_INTERESTS {
        int group_id PK, FK
        int interest_id PK, FK
    }
    GROUP_MEMBERS {
        int user_id PK, FK
        int group_id PK, FK
        string status "joined or pending"
        datetime joined_at
    }
    EVENTS {
        int id PK
        int group_id FK "optional, NULL = standalone event"
        int organizer_id FK "only this user may edit"
        string title
        string description
        datetime start_at "with time zone"
        string location
        int capacity "optional, greater than 0"
    }
    RSVPS {
        int user_id PK, FK
        int event_id PK, FK
        string status "registered or cancelled"
        datetime created_at
        datetime cancelled_at "set only if cancelled"
    }
