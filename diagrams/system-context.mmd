flowchart LR
    visitor(["Visitor"])
    user(["Registered User"])
    organizer(["Event Organizer<br/>(a Registered User)"])
    maintainer(["System Maintainer"])

    subgraph boundary [" "]
        system["Interest-Based Social Platform<br/>(web application + REST API)"]
    end

    db[("PostgreSQL<br/>database")]
    notif["External notification provider<br/>(out of MVP scope)"]

    visitor -- "view public groups and events,<br/>register, log in" --> system
    user -- "edit profile and interests,<br/>get recommendations, join/leave events" --> system
    organizer -- "create and edit own events,<br/>view RSVP count" --> system
    maintainer -- "configuration and<br/>operational logs" --> system
    system -- "reads / writes<br/>system records" --> db
    system -. "not in MVP" .-> notif

    style notif stroke-dasharray: 5 5
